<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Tamarindo - Menú Visual Premium</title>
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;600;800&family=Playfair+Display:ital,wght@1,900&display=swap" rel="stylesheet">
    <style>
        :root {
            --gold: #d4af37;
            --gold-light: #f1d592;
            --dark: #050a15;
            --neon-green: #22c55e;
            --card-bg: rgba(10, 15, 30, 0.98);
        }

        body {
            margin: 0; padding: 0;
            font-family: 'Poppins', sans-serif;
            background: #000;
            color: white;
            height: 100vh;
            overflow: hidden;
            display: flex; flex-direction: column;
        }

        #custom-bg {
            position: fixed; top: 0; left: 0; width: 100%; height: 100%;
            z-index: -2; background-size: cover; background-position: center;
            filter: brightness(0.2);
            transition: background-image 1.5s ease-in-out;
        }

        header {
            height: 12vh; display: flex; justify-content: space-between; align-items: center;
            padding: 0 4%; background: rgba(0,0,0,0.95); border-bottom: 2px solid var(--gold);
            z-index: 20;
        }

        .logo-container img { max-height: 55px; }
        #phrase-marquee { font-size: 1.5rem; font-weight: 800; color: var(--gold-light); text-transform: uppercase; }

        main { flex: 1; position: relative; padding: 15px; overflow: hidden; }

        #menu-grid {
            display: grid; grid-template-columns: repeat(4, 1fr);
            gap: 15px; height: 100%; align-items: center;
            transition: opacity 0.8s ease-in-out, transform 0.8s ease-in-out;
        }

        #specials-view {
            position: absolute; inset: 0;
            display: none; flex-direction: column;
            background: #000;
            padding: 30px; z-index: 10;
            opacity: 0; transition: opacity 0.5s ease;
        }

        .specials-header { 
            text-align: center; margin-bottom: 20px; 
            animation: glowText 2s infinite alternate;
        }

        .specials-header h2 { 
            font-family: 'Playfair Display', serif; font-size: 4.5rem; 
            color: #fff; margin: 0; font-style: italic;
            letter-spacing: -1px;
        }

        #specials-bento {
            display: grid; grid-template-columns: repeat(4, 1fr);
            grid-template-rows: repeat(2, 1fr); gap: 20px; height: 75vh;
        }

        .bento-item {
            border-radius: 30px; overflow: hidden; position: relative;
            border: 2px solid rgba(212, 175, 55, 0.4);
            box-shadow: 0 20px 50px rgba(0,0,0,0.8);
            opacity: 0; transform: translateY(50px);
        }

        .bento-item:nth-child(1) { grid-column: span 2; }
        .bento-item:nth-child(4) { grid-row: span 2; }

        .bento-item img { width: 100%; height: 100%; object-fit: cover; animation: kenBurns 15s infinite alternate; }

        .card {
            background: var(--card-bg); border: 2px solid rgba(255,255,255,0.05);
            border-radius: 25px; height: 90%; display: flex; flex-direction: column;
            overflow: hidden; transition: all 0.5s ease-in-out; position: relative;
        }
        .card.active { border-color: var(--gold); transform: translateY(-10px); box-shadow: 0 10px 40px rgba(212, 175, 55, 0.4); }

        .img-container { height: 65%; position: relative; overflow: hidden; border-bottom: 3px solid var(--gold); background: #111; }
        .img-container img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; opacity: 0; transition: opacity 2s ease-in-out, transform 10s linear; }
        .img-container img.active-img { opacity: 1; }
        .card.active .img-container img.active-img { transform: scale(1.15); }

        .info { padding: 12px; flex: 1; display: flex; flex-direction: column; text-align: center; justify-content: center; }
        .category-title { color: var(--gold-light); font-size: 0.8rem; letter-spacing: 2px; text-transform: uppercase; margin-bottom: 5px; }
        .content { font-size: 1.5rem; font-weight: 800; color: var(--neon-green); line-height: 1.2; }
        
        footer { height: 10vh; background: var(--gold); color: var(--dark); display: flex; justify-content: space-around; align-items: center; font-weight: 800; font-size: 1.8rem; }
        .clock-wrapper { transform: scale(0.65); }

        @keyframes glowText { from { text-shadow: 0 0 10px var(--gold); } to { text-shadow: 0 0 30px var(--gold), 0 0 10px #fff; } }
        @keyframes kenBurns { from { transform: scale(1); } to { transform: scale(1.25); } }
        @keyframes cascade { to { opacity: 1; transform: translateY(0); } }
        .cascade-anim { animation: cascade 0.8s ease forwards; }
    </style>
</head>
<body>

    <div id="custom-bg"></div>

    <header>
        <div class="logo-container"><img src="https://i.imgur.com/Sj9oMDM.gif" alt="Logo"></div>
        <div id="phrase-marquee">Tamarindo Premium</div>
        <div class="clock-wrapper">
            <script src="https://cdn.logwork.com/widget/digital.js"></script>
            <a href="https://logwork.com/current-time-in-bogota-colombia" class="digital-clock" data-style="style2" data-size="250" data-timezone="America/Bogota" data-language="es">Time</a>
        </div>
    </header>

    <main>
        <div id="menu-grid"></div>
        <div id="specials-view">
            <div class="specials-header">
                <h2 id="special-title-text">ANTOJO DEL DÍA</h2>
            </div>
            <div id="specials-bento"></div>
        </div>
    </main>

    <footer>
        <div>MESA: $15.000</div>
        <div>DOMICILIO: $16.000</div>
        <div style="font-size: 1.2rem;">📍 Cra 11 # 64 - 10 | Lourdes</div>
    </footer>

    <script>
        const CONFIG = {
            csvUrl: "https://docs.google.com/spreadsheets/d/e/2PACX-1vS29H3hxA9X8VcqQqGZlT4duXOIT3xAdIhExEIut9frN0i78naYSj6gnWFkWliWwKNLT5tGNlaYh16j/pub?output=csv",
            defaultImg: "https://images.unsplash.com/photo-1546069901-ba9599a7e63c?q=80&w=600",
            highlightInterval: 7000,
            imageSwitchInterval: 15000,
            cyclesToShowSpecials: 3
        };

        let imageOptions = [];
        let phraseOptions = [];
        let activeIndex = 0;
        let imgRotationIndex = 0;
        let cycleCount = 0;
        let isPromoActive = false;
        let currentSpecialText = "";

        async function init() {
            await loadData();
            setInterval(loadData, 120000);
            setInterval(rotateHighlight, CONFIG.highlightInterval);
            setInterval(rotateImagesOneByOne, CONFIG.imageSwitchInterval);
        }

        async function loadData() {
            try {
                const res = await fetch(`${CONFIG.csvUrl}&nocache=${Date.now()}`);
                const text = await res.text();
                const rows = text.split('\n').map(row => row.split(',').map(c => c.trim()));
                const hoy = ["DOMINGO", "LUNES", "MARTES", "MIERCOLES", "JUEVES", "VIERNES", "SABADO"][new Date().getDay()];
                const currentData = rows.find(r => r[0] && r[0].toUpperCase() === hoy) || rows[1];
                
                imageOptions = rows.filter(r => r[0] && r[0].toLowerCase().includes("imagenes"));
                phraseOptions = rows.filter(r => r[0] && r[0].toUpperCase().replace(/\s/g, '') === "FRASES")
                                    .flatMap(row => row.slice(1).filter(c => c !== ""));

                currentSpecialText = currentData[6]; 
                if (!isPromoActive) renderMenu(currentData);
                updatePhrase();
                updateBackground();
            } catch (e) { console.error(e); }
        }

        function renderMenu(data) {
            const categories = [
                { title: 'Principios', content: data[1], col: 1 },
                { title: 'Proteínas', content: data[2], col: 2 },
                { title: 'Acompañantes', content: data[3], col: 3 },
                { title: 'Bebida', content: data[5], col: 5 }
            ];
            const grid = document.getElementById('menu-grid');
            grid.innerHTML = categories.map((cat, i) => `
                <div class="card" id="card-${i}" data-col="${cat.col}">
                    <div class="img-container" id="img-cont-${i}">
                        <img src="${getImgForCategory(cat.col)}" class="active-img">
                    </div>
                    <div class="info">
                        <div class="category-title">${cat.title}</div>
                        <div class="content">${formatList(cat.content)}</div>
                    </div>
                </div>
            `).join('');
            highlightCard(activeIndex);
        }

        function getImgForCategory(col, currentUrl = "") {
            const valid = imageOptions.filter(r => r[col] && r[col].startsWith('http')).map(r => r[col]);
            if (!valid.length) return CONFIG.defaultImg;
            
            // Si solo hay una imagen, retornarla sin más
            if (valid.length === 1) return valid[0];

            let nextImg;
            let attempts = 0;
            // Intentar obtener una imagen distinta a la actual (máximo 5 intentos)
            do {
                nextImg = valid[Math.floor(Math.random() * valid.length)];
                attempts++;
            } while (nextImg === currentUrl && attempts < 5);

            return nextImg;
        }

        function rotateImagesOneByOne() {
            if (isPromoActive) return;
            const cardIdx = imgRotationIndex % 4;
            const card = document.getElementById(`card-${cardIdx}`);
            const container = document.getElementById(`img-cont-${cardIdx}`);
            if (!card || !container) return;

            const currentImgElement = container.querySelector('.active-img');
            const currentUrl = currentImgElement ? currentImgElement.src : "";
            const nextImgUrl = getImgForCategory(card.dataset.col, currentUrl);

            // LOGICA PEDIDA: Si la imagen es la misma, no hacer nada (no disparar transicion)
            if (nextImgUrl === currentUrl) {
                imgRotationIndex++;
                return;
            }

            const nextImg = document.createElement('img');
            nextImg.src = nextImgUrl;
            container.appendChild(nextImg);

            setTimeout(() => {
                if (currentImgElement) currentImgElement.classList.remove('active-img');
                nextImg.classList.add('active-img');
                setTimeout(() => { if (currentImgElement) currentImgElement.remove(); }, 2100);
            }, 50);
            imgRotationIndex++;
        }

        function rotateHighlight() {
            if (isPromoActive) return;
            activeIndex = (activeIndex + 1) % 4;
            highlightCard(activeIndex);
            if (activeIndex === 0) {
                cycleCount++;
                updatePhrase();
                updateBackground();
                if (cycleCount % CONFIG.cyclesToShowSpecials === 0) toggleSpecials(true);
            }
        }

        function toggleSpecials(show) {
            const menuGrid = document.getElementById('menu-grid');
            const specialsView = document.getElementById('specials-view');
            const bento = document.getElementById('specials-bento');

            if (show) {
                isPromoActive = true;
                document.getElementById('special-title-text').innerText = currentSpecialText;
                const imgs = imageOptions.map(r => r[6]).filter(l => l?.startsWith('http')).slice(0, 5);
                bento.innerHTML = imgs.map((src, i) => `<div class="bento-item"><img src="${src}"></div>`).join('');

                menuGrid.style.opacity = '0';
                setTimeout(() => {
                    menuGrid.style.display = 'none';
                    specialsView.style.display = 'flex';
                    setTimeout(() => {
                        specialsView.style.opacity = '1';
                        document.querySelectorAll('.bento-item').forEach((el, i) => {
                            el.style.animationDelay = (i * 0.15) + 's';
                            el.classList.add('cascade-anim');
                        });
                    }, 50);
                }, 800);
                setTimeout(() => toggleSpecials(false), 12000);
            } else {
                specialsView.style.opacity = '0';
                setTimeout(() => {
                    specialsView.style.display = 'none';
                    menuGrid.style.display = 'grid';
                    setTimeout(() => {
                        menuGrid.style.opacity = '1';
                        isPromoActive = false;
                        activeIndex = 0;
                        highlightCard(0);
                    }, 50);
                }, 800);
            }
        }

        function highlightCard(idx) {
            document.querySelectorAll('.card').forEach((c, i) => c.classList.toggle('active', i === idx));
        }

        function formatList(raw) {
            return raw ? `<ul style="list-style:none;padding:0;margin:0;">${raw.split('-').filter(t => t.trim()).map(t => `<li style="margin-bottom:4px;">${t.trim()}</li>`).join('')}</ul>` : '---';
        }

        function updatePhrase() {
            const el = document.getElementById('phrase-marquee');
            if (phraseOptions.length) el.innerText = phraseOptions[Math.floor(Math.random() * phraseOptions.length)];
        }

        function updateBackground() {
            const bgImgs = imageOptions.map(f => f[0]).filter(img => img?.startsWith('http'));
            if (bgImgs.length) document.getElementById('custom-bg').style.backgroundImage = `url('${bgImgs[Math.floor(Math.random() * bgImgs.length)]}')`;
        }

        init();
    </script>
</body>
</html>
