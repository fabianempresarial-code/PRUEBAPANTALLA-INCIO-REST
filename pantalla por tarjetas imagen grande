<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Tamarindo - Menú Visual Premium</title>
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;600;800&display=swap" rel="stylesheet">
    <style>
        :root {
            --gold: #d4af37;
            --gold-light: #f1d592;
            --dark: #050a15;
            --neon-green: #22c55e;
            --card-bg: rgba(10, 15, 30, 0.98);
        }

        body {
            margin: 0; padding: 0;
            font-family: 'Poppins', sans-serif;
            background: #000;
            color: white;
            height: 100vh;
            overflow: hidden;
            display: flex; flex-direction: column;
        }

        #custom-bg {
            position: fixed; top: 0; left: 0; width: 100%; height: 100%;
            z-index: -2; background-size: cover; background-position: center;
            filter: brightness(0.2);
            transition: background-image 1.5s ease-in-out;
        }

        header {
            height: 12vh; display: flex; justify-content: space-between; align-items: center;
            padding: 0 4%; background: rgba(0,0,0,0.9); border-bottom: 2px solid var(--gold);
        }

        .logo-container img { max-height: 55px; }

        #phrase-marquee {
            font-size: 1.5rem; font-weight: 800; color: var(--gold-light);
            text-transform: uppercase;
        }

        main {
            flex: 1;
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 15px;
            padding: 15px;
            align-items: center;
        }

        .card {
            background: var(--card-bg);
            border: 2px solid rgba(255,255,255,0.05);
            border-radius: 25px;
            height: 90%;
            display: flex;
            flex-direction: column;
            overflow: hidden;
            transition: all 0.5s ease-in-out;
            position: relative;
        }

        .card.active {
            border-color: var(--gold);
            transform: translateY(-10px);
            box-shadow: 0 10px 40px rgba(212, 175, 55, 0.4);
        }

        /* IMAGEN AGRANDADA AL 65% */
        .img-container {
            height: 65%; 
            overflow: hidden;
            border-bottom: 3px solid var(--gold);
            background: #111;
        }

        .img-container img {
            width: 100%; height: 100%; object-fit: cover;
            transition: transform 8s ease-in-out;
        }

        .card.active .img-container img {
            transform: scale(1.15);
        }

        .info {
            padding: 12px;
            flex: 1;
            display: flex;
            flex-direction: column;
            justify-content: flex-start;
            text-align: center;
        }

        .category-title {
            color: var(--gold-light);
            font-size: 0.75rem;
            letter-spacing: 3px;
            margin-bottom: 8px;
            text-transform: uppercase;
            font-weight: 300;
        }

        .content {
            font-size: 1.4rem; /* Ajustado para que quepa bien */
            font-weight: 800;
            color: var(--neon-green);
            line-height: 1.2;
        }

        .menu-list { list-style: none; padding: 0; margin: 0; }
        .menu-list li { margin-bottom: 4px; text-transform: capitalize; }

        footer {
            height: 10vh; background: var(--gold); color: var(--dark);
            display: flex; justify-content: space-around; align-items: center;
            font-weight: 800; font-size: 1.8rem;
        }

        .clock-wrapper { transform: scale(0.65); }
    </style>
</head>
<body>

    <div id="custom-bg"></div>

    <header>
        <div class="logo-container"><img src="https://i.imgur.com/Sj9oMDM.gif" alt="Logo"></div>
        <div id="phrase-marquee">Bienvenido a Tamarindo</div>
        <div class="clock-wrapper">
            <script src="https://cdn.logwork.com/widget/digital.js"></script>
            <a href="https://logwork.com/current-time-in-bogota-colombia" class="digital-clock" data-style="style2" data-size="250" data-timezone="America/Bogota" data-language="en">Time</a>
        </div>
    </header>

    <main id="menu-grid"></main>

    <footer>
        <div>MESA: $15.000</div>
        <div>DOMICILIO: $16.000</div>
        <div style="font-size: 1rem;">📍 Cra 11 # 64 - 10 | Parque Lourdes</div>
    </footer>

    <script>
        const CONFIG = {
            csvUrl: "https://docs.google.com/spreadsheets/d/e/2PACX-1vS29H3hxA9X8VcqQqGZlT4duXOIT3xAdIhExEIut9frN0i78naYSj6gnWFkWliWwKNLT5tGNlaYh16j/pub?output=csv",
            defaultImg: "https://images.unsplash.com/photo-1546069901-ba9599a7e63c?q=80&w=600",
            defaultBg: "https://images.unsplash.com/photo-1514362545857-3bc16c4c7d1b?q=80&w=1200",
            switchInterval: 7000 
        };

        let imageOptions = [];
        let phraseOptions = [];
        let activeIndex = 0;

        async function init() {
            await loadData();
            setInterval(loadData, 120000); 
            setInterval(rotateHighlight, CONFIG.switchInterval);
        }

        async function loadData() {
            try {
                const res = await fetch(`${CONFIG.csvUrl}&nocache=${Date.now()}`);
                const text = await res.text();
                const rows = text.split('\n').map(row => row.split(',').map(c => c.trim()));
                
                const dias = ["DOMINGO", "LUNES", "MARTES", "MIERCOLES", "JUEVES", "VIERNES", "SABADO"];
                const hoy = dias[new Date().getDay()];
                const currentData = rows.find(r => r[0] && r[0].toUpperCase() === hoy) || rows[1];
                
                imageOptions = rows.filter(r => r[0] && r[0].toLowerCase().includes("imagenes"));
                phraseOptions = rows.filter(r => r[0] && r[0].toUpperCase().replace(/\s/g, '') === "FRASES")
                                    .flatMap(row => row.slice(1).filter(c => c !== ""));

                renderMenu(currentData);
                updatePhrase();
                updateBackground();
            } catch (e) { console.error("Error:", e); }
        }

        function renderMenu(data) {
            const categories = [
                { title: 'Principios', content: data[1], col: 1 },
                { title: 'Proteínas', content: data[2], col: 2 },
                { title: 'Acompañantes', content: data[3], col: 3 },
                { title: 'Bebida', content: data[5] || "Jugo Natural", col: 5 }
            ];

            const grid = document.getElementById('menu-grid');
            grid.innerHTML = categories.map((cat, i) => {
                // Buscamos la imagen en la fila de imágenes correspondiente a la columna del plato
                const img = (imageOptions.length > 0 && imageOptions[0][cat.col]) ? imageOptions[0][cat.col] : CONFIG.defaultImg;
                return `
                    <div class="card" id="card-${i}">
                        <div class="img-container">
                            <img src="${img}" id="img-${i}">
                        </div>
                        <div class="info">
                            <div class="category-title">${cat.title}</div>
                            <div class="content">${formatList(cat.content)}</div>
                        </div>
                    </div>
                `;
            }).join('');
            
            highlightCard(0);
        }

        function formatList(raw) {
            if (!raw) return '---';
            const items = raw.split('-').filter(t => t.trim());
            if (items.length > 3) {
                // Si hay muchos items, reducimos la letra un poco más
                return `<ul class="menu-list" style="font-size: 0.9em;">${items.map(t => `<li>${t.trim()}</li>`).join('')}</ul>`;
            }
            return `<ul class="menu-list">${items.map(t => `<li>${t.trim()}</li>`).join('')}</ul>`;
        }

        function rotateHighlight() {
            activeIndex = (activeIndex + 1) % 4;
            highlightCard(activeIndex);
            if (activeIndex === 0) {
                updatePhrase();
                updateBackground();
            }
        }

        function highlightCard(index) {
            document.querySelectorAll('.card').forEach((c, i) => {
                c.classList.toggle('active', i === index);
            });
        }

        function updatePhrase() {
            const el = document.getElementById('phrase-marquee');
            if (phraseOptions.length > 0) {
                el.innerText = phraseOptions[Math.floor(Math.random() * phraseOptions.length)];
            }
        }

        function updateBackground() {
            const bg = document.getElementById('custom-bg');
            const bgImgs = imageOptions.map(f => f[0]).filter(img => img && img.startsWith('http'));
            const selected = bgImgs.length > 0 ? bgImgs[Math.floor(Math.random() * bgImgs.length)] : CONFIG.defaultBg;
            bg.style.backgroundImage = `url('${selected}')`;
        }

        init();
    </script>
</body>
</html>
