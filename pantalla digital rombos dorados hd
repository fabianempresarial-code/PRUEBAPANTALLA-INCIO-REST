<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Tamarindo - Menú Diamond Pro Fixed</title>
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;600;800&family=Playball&display=swap" rel="stylesheet">
    <style>
        :root {
            --gold: #d4af37;
            --neon-green: #22c55e;
            --bg-blur: 15px;
        }

        body {
            margin: 0; padding: 0;
            font-family: 'Poppins', sans-serif;
            background: #000; color: white;
            height: 100vh; overflow: hidden;
            display: flex; flex-direction: column;
        }

        #custom-bg {
            position: fixed; top: 0; left: 0; width: 100%; height: 100%;
            z-index: -2; background-size: cover; background-position: center;
            filter: brightness(0.25) blur(var(--bg-blur));
            transition: background-image 2.5s ease-in-out;
            transform: scale(1.1);
        }

        header {
            height: 12vh; display: flex; justify-content: space-between; align-items: center;
            padding: 0 4%; background: rgba(0,0,0,0.9); border-bottom: 3px solid var(--gold);
            z-index: 10;
        }

        .logo-container img { max-height: 55px; }
        #phrase-marquee { font-size: 1.5rem; font-weight: 800; color: var(--gold); text-transform: uppercase; }

        main {
            flex: 1; display: flex; justify-content: center; align-items: center;
            gap: 45px; padding: 20px;
        }

        /* --- CONTENEDOR ROMBO --- */
        .card-container {
            position: relative; width: 280px; height: 280px;
            display: flex; justify-content: center; align-items: center;
            transition: all 0.8s cubic-bezier(0.4, 0, 0.2, 1);
        }

        .diamond-card {
            width: 100%; height: 100%;
            background: rgba(10, 10, 10, 0.95);
            transform: rotate(45deg);
            border: 2px solid #333;
            border-radius: 20px;
            overflow: hidden;
            position: relative;
            display: flex; justify-content: center; align-items: center;
            transition: all 0.6s ease;
        }

        .card-container.active { transform: scale(1.18); z-index: 5; }
        .card-container.active .diamond-card { 
            border: 4px solid var(--gold); 
            box-shadow: 0 0 30px rgba(212, 175, 55, 0.6);
            animation: pulse-border 2s infinite ease-in-out;
        }

        @keyframes pulse-border {
            0%, 100% { box-shadow: 0 0 20px rgba(212, 175, 55, 0.4); }
            50% { box-shadow: 0 0 50px rgba(212, 175, 55, 0.8); }
        }

        .card-inner-content {
            transform: rotate(-45deg);
            text-align: center; width: 140%; height: 140%;
            display: flex; flex-direction: column; justify-content: center; align-items: center;
        }

        .card-img-bg {
            position: absolute; top: 0; left: 0; width: 100%; height: 100%;
            object-fit: cover; opacity: 0.35; 
            transition: transform 10s linear, opacity 0.6s ease;
        }

        .card-container.active .card-img-bg { 
            opacity: 0.7; 
            transform: scale(1.3) rotate(-2deg); 
        }

        .badge { 
            background: var(--gold); color: #000; font-weight: 900; 
            padding: 5px 15px; border-radius: 5px; font-size: 1rem; 
            margin-bottom: 12px; z-index: 2; text-transform: uppercase;
        }

        .list-items { 
            color: var(--neon-green); font-size: 1.4rem; font-weight: 800; 
            line-height: 1.2; list-style: none; padding: 0; margin: 0; z-index: 2;
            text-shadow: 3px 3px 6px #000;
        }

        /* --- ESPECIALES OVERLAY --- */
        #special-overlay {
            position: absolute; top: 12vh; left: 0; width: 100%; height: 78vh;
            background: rgba(0,0,0,0.98); display: none; z-index: 100;
            animation: slideIn 0.8s ease-out;
        }

        @keyframes slideIn {
            from { transform: translateY(100%); opacity: 0; }
            to { transform: translateY(0); opacity: 1; }
        }

        .special-container { display: flex; height: 100%; align-items: center; padding: 0 5%; }
        .collage-side { flex: 1.2; display: grid; grid-template-columns: repeat(2, 1fr); gap: 35px; }
        .collage-diamond { 
            width: 220px; height: 220px; transform: rotate(45deg) scale(0.8); 
            border: 4px solid var(--gold); overflow: hidden; border-radius: 15px;
            opacity: 0; animation: popIn 0.6s forwards;
        }

        @keyframes popIn { to { opacity: 1; transform: rotate(45deg) scale(1); } }
        .collage-diamond img { width: 160%; height: 160%; object-fit: cover; transform: rotate(-45deg); }
        .text-side { flex: 1; padding-left: 60px; animation: fadeInRight 1s ease-out 0.4s both; }

        @keyframes fadeInRight {
            from { opacity: 0; transform: translateX(50px); }
            to { opacity: 1; transform: translateX(0); }
        }

        .spec-title { font-family: 'Playball', cursive; font-size: 4.5rem; color: var(--gold); margin: 0; }
        .spec-list { list-style: none; padding: 0; font-size: 2.8rem; color: var(--neon-green); font-weight: 800; }
        .spec-list li { margin-bottom: 20px; border-left: 12px solid var(--gold); padding-left: 20px; }

        footer { height: 10vh; background: var(--gold); color: #000; display: flex; justify-content: space-around; align-items: center; font-weight: 900; font-size: 2.2rem; }
    </style>
</head>
<body>

    <div id="custom-bg"></div>

    <header>
        <div class="logo-container"><img src="https://i.imgur.com/Sj9oMDM.gif" alt="Logo"></div>
        <div id="phrase-marquee">SABOR QUE ENAMORA</div>
        <div style="transform: scale(0.7);">
            <script src="https://cdn.logwork.com/widget/digital.js"></script>
            <a href="https://logwork.com/current-time-in-bogota-colombia" class="digital-clock" data-style="style2" data-size="250" data-timezone="America/Bogota" data-language="en">Time</a>
        </div>
    </header>

    <div id="special-overlay"></div>
    <main id="menu-grid"></main>

    <footer>
        <div>MESA: $15.000</div>
        <div>DOMICILIO: $16.000</div>
        <div style="font-size: 1.3rem;">📍 PARQUE LOURDES</div>
    </footer>

    <script>
        const SHEET_URL = "https://docs.google.com/spreadsheets/d/e/2PACX-1vS29H3hxA9X8VcqQqGZlT4duXOIT3xAdIhExEIut9frN0i78naYSj6gnWFkWliWwKNLT5tGNlaYh16j/pub?output=csv";
        let activeIdx = 0;
        let sheetData = { cards: [], specials: { text: [], imgs: [] }, phrases: [] };
        let cycleTimer;

        async function init() {
            await loadData();
            startCycle(); // Iniciamos el ciclo después de cargar datos
            setInterval(loadData, 180000);
        }

        async function loadData() {
            try {
                const res = await fetch(`${SHEET_URL}&v=${Date.now()}`);
                const csv = await res.text();
                const rows = csv.split('\n').map(r => r.split(',').map(c => c.trim()));
                
                const hoy = ["DOMINGO", "LUNES", "MARTES", "MIERCOLES", "JUEVES", "VIERNES", "SABADO"][new Date().getDay()];
                const dayRow = rows.find(r => r[0].toUpperCase() === hoy) || rows[1];
                const imgRows = rows.filter(r => r[0].toLowerCase().includes("imagenes"));

                sheetData.cards = [
                    { t: 'Principios', c: dayRow[1], img: imgRows[0][1] },
                    { t: 'Proteínas', c: dayRow[2], img: imgRows[0][2] },
                    { t: 'Entradas', c: dayRow[4], img: imgRows[0][4] },
                    { t: 'Bebidas', c: dayRow[5], img: imgRows[0][5] }
                ];

                sheetData.specials.text = dayRow[6].split('-').filter(i => i);
                sheetData.specials.imgs = imgRows.map(r => r[6]).filter(url => url && url.startsWith('http'));
                sheetData.phrases = rows.filter(r => r[0].includes("FRASES")).flatMap(r => r.slice(1).filter(c => c));

                renderMenu();
            } catch (e) { console.error(e); }
        }

        function renderMenu() {
            const grid = document.getElementById('menu-grid');
            grid.innerHTML = sheetData.cards.map((cat, i) => `
                <div class="card-container" id="card-${i}">
                    <div class="diamond-card">
                        <img class="card-img-bg" src="${cat.img}">
                        <div class="card-inner-content">
                            <div class="badge">${cat.t}</div>
                            <ul class="list-items">${cat.c.split('-').map(li => `<li>${li}</li>`).join('')}</ul>
                        </div>
                    </div>
                </div>
            `).join('');
            setActive(activeIdx);
        }

        function setActive(idx) {
            document.querySelectorAll('.card-container').forEach((c, i) => {
                c.classList.toggle('active', i === idx);
            });
        }

        function startCycle() {
            if(cycleTimer) clearInterval(cycleTimer);
            cycleTimer = setInterval(cycle, 8000);
        }

        function cycle() {
            if (activeIdx < 3) {
                activeIdx++;
                setActive(activeIdx);
            } else {
                showSpecials();
            }
        }

        function showSpecials() {
            clearInterval(cycleTimer); // Pausamos el ciclo para mostrar especiales
            const overlay = document.getElementById('special-overlay');
            const grid = document.getElementById('menu-grid');
            
            const imgs = sheetData.specials.imgs.slice(0, 4);
            while(imgs.length < 4) imgs.push(imgs[0]);

            overlay.innerHTML = `
                <div class="special-container">
                    <div class="collage-side">
                        ${imgs.map((url, i) => `<div class="collage-diamond" style="animation-delay: ${i * 0.2}s"><img src="${url}"></div>`).join('')}
                    </div>
                    <div class="text-side">
                        <div class="spec-title">Nuestra Selección</div>
                        <div style="font-size: 5rem; font-weight: 800; line-height: 1; letter-spacing: -2px;">ESPECIALES</div>
                        <ul class="spec-list">${sheetData.specials.text.map(t => `<li>${t}</li>`).join('')}</ul>
                    </div>
                </div>
            `;

            grid.style.opacity = "0";
            overlay.style.display = "block";

            setTimeout(() => {
                overlay.style.display = "none";
                grid.style.opacity = "1";
                activeIdx = 0;
                setActive(0);
                updateExtras();
                startCycle(); // Reiniciamos el ciclo
            }, 14000);
        }

        function updateExtras() {
            if(sheetData.phrases.length) {
                document.getElementById('phrase-marquee').innerText = sheetData.phrases[Math.floor(Math.random()*sheetData.phrases.length)];
            }
            const allImgs = sheetData.cards.map(c => c.img);
            document.getElementById('custom-bg').style.backgroundImage = `url('${allImgs[Math.floor(Math.random()*allImgs.length)]}')`;
        }

        init();
    </script>
</body>
</html>
